{
  "name": "bill-search-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local MCP bill checklist using host-supplied Gmail metadata",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run build:server",
    "serve": "tsx main.ts",
    "serve:stdio": "tsx main.ts --stdio",
    "build:server": "esbuild main.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/server.mjs --banner:js='import{createRequire as __cr}from\"module\";const require=__cr(import.meta.url);'",
    "test": "node --import tsx --test build/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
