# HTTP port for the streamable-HTTP transport (unused in --stdio mode, which
# is what the plugin's .mcp.json actually uses)
PORT=3001

# Bind address. Loopback by default — change deliberately if you want this
# reachable beyond localhost, not by accident.
HOST=127.0.0.1

# Bearer/query token required on every /mcp request (HTTP mode only). Leave
# unset to auto-generate and persist one to ~/.bill-search-app/mcp-token.txt.
# MCP_AUTH_TOKEN=

# Default root_folder used when save_bills omits it
BILLS_ROOT_DEFAULT=~/Documents/Bills

# Concurrent attachment fetches/writes during save_bills
SAVE_CONCURRENCY=5
